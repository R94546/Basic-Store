{
  "hosting": {
    "site": "basicstore-admin",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/flutter_bootstrap.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/flutter_service_worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/main.dart.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/canvaskit/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }] },
      { "source": "**/*.@(wasm|woff2|woff|ttf|otf|png|jpg|jpeg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
    ]
  }
}
