{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "zara-shop-automation-uz",
          "appId": "1:24388481813:android:7e404f449cd24bc782ef1c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "zara-shop-automation-uz",
          "configurations": {
            "android": "1:24388481813:android:7e404f449cd24bc782ef1c",
            "ios": "1:24388481813:ios:e9a74d8642ed8a6682ef1c"
          }
        }
      }
    }
  },
  "hosting": {
    "site": "zara-shop-automation-uz",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/main.dart.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/canvaskit/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
      },
      {
        "source": "**/*.@(wasm|woff2|woff|ttf|otf|png|jpg|jpeg|svg)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
