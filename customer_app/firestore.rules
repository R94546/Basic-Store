rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Faqat admin (do'kon egasi)
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'sG47ERuLIdSFeWI84ErNYy2y2b02';
    }

    // Mahsulotlar — hamma o'qiydi (mijoz katalogi), faqat admin yozadi
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /variants/{vid} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Kategoriyalar — hamma o'qiydi, admin yozadi
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Buyurtmalar.
    // - create: ochiq (mijoz buyurtma bera olishi shart, anonim auth bo'lmasa ham)
    // - read: FAQAT egasi (anonim auth uid) yoki admin — PII (telefon/manzil/GPS)
    //   butun dunyoga ochiq bo'lmasligi uchun
    // - update: admin, yoki egasi o'z PENDING buyurtmasini bekor qilishi mumkin
    // - delete: faqat admin
    match /orders/{id} {
      allow create: if true;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // Qolgan hammasi (sotuvlar, mijozlar, qarzlar, smenalar, prixod,
    // sozlamalar...) — faqat admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
